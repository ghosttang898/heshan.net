# Host Nginx http-context template. Install only after deployment approval.
# Certificates and the Cloudflare include must already exist. No DNS changes here.
map "$status:$uri" $heshan_cache_control {
    default "no-store";
    ~^(200|304):/assets/ "public, max-age=31536000, immutable";
}
server {
    listen 80;
    server_name heshan.net www.heshan.net;
    access_log off;
    error_log /var/log/nginx/heshan-error.log crit;
    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
        try_files $uri =404;
    }
    location / { return 308 https://heshan.net$request_uri; }
}
server {
    listen 443 ssl;
    server_name heshan.net www.heshan.net;
    if ($host !~ ^(heshan\.net|www\.heshan\.net)$) { return 444; }
    ssl_certificate /etc/heshan/tls/fullchain.pem;
    ssl_certificate_key /etc/heshan/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    include /etc/nginx/heshan-cloudflare-realip.conf;
    real_ip_header CF-Connecting-IP;
    real_ip_recursive off;
    root /srv/heshan/frontend-current;
    index index.html;
    server_tokens off;
    client_max_body_size 32k;
    access_log off;
    error_log /var/log/nginx/heshan-error.log crit;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
    add_header Cache-Control $heshan_cache_control always;
    location = /api { return 404; }
    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_hide_header Cache-Control;
        proxy_hide_header Expires;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
    location ~ /\. { return 404; }
    location /assets/ { try_files $uri =404; }
    location / { try_files $uri $uri/ /index.html; }
}
