POSTGRES_USER=heshan_prod_app
POSTGRES_PASSWORD=
POSTGRES_ADMIN_PASSWORD=
APP_JWT_SECRET=
APP_CORS_ALLOWED_ORIGINS=https://heshan.net,https://www.heshan.net
BACKEND_IMAGE=heshan-backend:a67f2bf4ad1765abd48c00856c3e9cd9a94efb9a
BACKUP_DIR=/var/backups/heshan
BACKUP_OFFSITE=0
# Metadata only; NOT an automatic account initialization setting.
FOUNDER_USERNAME=ghost
