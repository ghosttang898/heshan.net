# Copy to a server-local mode-0600 .env; never commit actual values.
POSTGRES_DB=heshan
POSTGRES_USER=heshan_app
POSTGRES_PASSWORD=
POSTGRES_ADMIN_PASSWORD=
APP_JWT_SECRET=
APP_CORS_ALLOWED_ORIGINS=https://heshan.net,https://www.heshan.net
# Build/tag locally or in CI. Prefer immutable registry digests before release.
BACKEND_IMAGE=
# Deployment metadata only: never automatically promotes a registered user.
# Copy this approved name into the one-time command AFTER verifying the account ID.
FOUNDER_USERNAME=ghost
BACKUP_DIR=/var/backups/heshan
RCLONE_CONFIG=/etc/heshan/rclone.conf
# An externally hosted rclone remote, e.g. an approved S3 bucket/prefix.
BACKUP_REMOTE=
# Optional when compose.geoip.yml is selected; keep MMDB out of Git.
GEOIP_DATABASE_FILE=
